#!/usr/bin/env bash
# Bootstrap the mchost development environment with uv.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$ROOT"

if ! command -v uv >/dev/null 2>&1; then
    echo "mchost needs uv (https://docs.astral.sh/uv/)." >&2
    echo "Install it, then run this script again." >&2
    exit 1
fi

exec uv run --project "$ROOT" --quiet mchost "$@"
