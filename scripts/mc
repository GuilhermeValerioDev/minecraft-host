#!/usr/bin/env bash
# Backwards-compatible wrapper around mchost.
#
# The original single-instance workflow read INSTANCE from .env. New scripts
# should call mchost directly (mchost start <slug>); this shim exists so old
# muscle memory and any external scripts keep working during the transition.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$ROOT"

if [[ -x "$ROOT/mchost" ]]; then
    MCHOST="$ROOT/mchost"
elif command -v mchost >/dev/null 2>&1; then
    MCHOST="$(command -v mchost)"
else
    echo "❌ mchost not found." >&2
    exit 1
fi

INSTANCE=""
if [[ -f .env ]]; then
    INSTANCE="$(sed -n 's/^INSTANCE=//p' .env | tail -n 1 | tr -d "\"'")"
fi

usage() {
cat <<EOF
Minecraft Host CLI (compatibility shim)

Usage:
  mc start
  mc stop
  mc restart
  mc status
  mc logs
  mc console
  mc cmd "<command>"

The instance is read from INSTANCE in .env. For multiple instances use
mchost directly, for example: mchost switch FTBNeoTech
EOF
}

require_instance() {
    if [[ -z "$INSTANCE" ]]; then
        echo "❌ INSTANCE is not set in .env; use mchost directly." >&2
        exit 1
    fi
}

case "${1:-}" in
    start|stop|restart|status|logs|console)
        require_instance
        exec "$MCHOST" "$1" "$INSTANCE"
        ;;

    cmd)
        require_instance
        shift
        if [[ -z "$*" ]]; then
            echo 'Usage: mc cmd "<minecraft command>"' >&2
            exit 1
        fi
        exec "$MCHOST" cmd "$INSTANCE" "$*"
        ;;

    ""|-h|--help|help)
        usage
        ;;

    *)
        # Anything new can go straight through to mchost.
        exec "$MCHOST" "$@"
        ;;
esac
